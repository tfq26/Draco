---
import Layout from '../layouts/Layout.astro';
import MonitoringCharts from '../components/MonitoringCharts.vue';

const title = "Cloud Monitoring Hub";
---

<Layout title={title}>
  <main class="container py-12">
    <header class="mb-12">
      <h1 class="text-4xl font-black text-white mb-2 tracking-tight">Governance <span class="text-red-600">Command Center</span></h1>
      <p class="text-slate-400 text-lg">Real-time cross-cloud observability and cost management.</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
      <!-- Quick Stats -->
      <div class="glass-card p-8 rounded-2xl border border-white/5 bg-white/5 backdrop-blur-xl">
        <p class="text-slate-500 uppercase tracking-widest text-xs font-bold mb-1">Total Cloud Spends</p>
        <h2 class="text-3xl font-black text-white">$4,281.40</h2>
        <p class="text-green-500 text-sm mt-2 flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
          </svg>
          2.4% vs last month
        </p>
      </div>

      <div class="glass-card p-8 rounded-2xl border border-white/5 bg-white/5 backdrop-blur-xl">
        <p class="text-slate-500 uppercase tracking-widest text-xs font-bold mb-1">Active Resources</p>
        <h2 class="text-3xl font-black text-white">42</h2>
        <div class="flex gap-2 mt-3">
          <span class="px-2 py-1 rounded bg-blue-500/20 text-blue-400 text-[10px] font-bold">AZURE: 24</span>
          <span class="px-2 py-1 rounded bg-orange-500/20 text-orange-400 text-[10px] font-bold">AWS: 18</span>
        </div>
      </div>

      <div class="glass-card p-8 rounded-2xl border border-white/5 bg-white/5 backdrop-blur-xl">
        <p class="text-slate-500 uppercase tracking-widest text-xs font-bold mb-1">Governance Score</p>
        <h2 class="text-3xl font-black text-white">92</h2>
        <div class="w-full bg-white/10 h-1.5 rounded-full mt-4 overflow-hidden">
          <div class="bg-red-600 h-full" style="width: 92%"></div>
        </div>
      </div>
    </div>

    <!-- Interactive Charts Section -->
    <MonitoringCharts client:load />

    <!-- Active High-Cost Instances List -->
    <section class="mt-12">
      <h3 class="text-xl font-bold text-white mb-6">High-Impact Resources</h3>
      <div class="space-y-4">
        {['db-prod-east', 'vm-compute-worker-01', 's3-archive-storage'].map((item, i) => (
          <div class="flex items-center justify-between p-5 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.05] transition-all group">
            <div class="flex items-center gap-4">
              <div class={`w-2 h-2 rounded-full ${i === 0 ? 'bg-red-500 animate-pulse' : 'bg-green-500'}`}></div>
              <div>
                <p class="text-white font-bold">{item}</p>
                <p class="text-xs text-slate-500 tracking-wide uppercase">{i === 1 ? 'AWS EC2' : 'Azure SQL'}</p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-white font-black">${(250.45 * (i + 1)).toFixed(2)}/mo</p>
              <button class="text-[10px] font-black text-red-500 uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
                Stop Instance
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .glass-card {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .glass-card:hover {
    transform: translateY(-4px);
  }
</style>
