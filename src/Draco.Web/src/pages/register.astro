---
import Layout from '../layouts/Layout.astro';
import UnifiedAuth from '../components/UnifiedAuth.vue';
---

<Layout title="Create Account">
	<main class="auth-page">
		<UnifiedAuth initialMode="signup" client:load />
	</main>
</Layout>

<style>
	.auth-page {
		min-height: calc(100vh - 100px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}
</style>
