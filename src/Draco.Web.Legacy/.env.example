# Neon PostgreSQL Connection String
DATABASE_URL=postgres://user:password@hostname/dbname?sslmode=require
DRACO_DB_MAIN_CONNECTION=postgres://user:password@hostname/dbname?sslmode=require

# Neon Auth endpoint (must end with /auth)
PUBLIC_NEON_AUTH_URL=https://<your-project>.neonauth.<region>.aws.neon.tech/neondb/auth

# Draco API base URL
PUBLIC_DRACO_API_URL=http://localhost:5020

# Optional: Port for the local dev server
PORT=4321
